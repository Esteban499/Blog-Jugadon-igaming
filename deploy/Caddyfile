# Caddy termina TLS (Let's Encrypt, automatico) y le pasa todo a la app.
# El dominio sale de DOMINIO en produccion.env.

{$DOMINIO} {
	encode zstd gzip

	header {
		# Solo HTTPS por un anio. Lo pone el proxy y no la app porque es el
		# unico que sabe que la conexion llego cifrada.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# ---- Panel restringido por IP (recomendado) ----
	# El panel y la API de Payload no los usa el publico: el sitio consulta la
	# base por la Local API, del lado del servidor. La unica ruta de /api que
	# tiene que quedar abierta es la de las imagenes.
	#
	# Descomentar y poner las IPs de la oficina o de la VPN. Si la VM queda
	# detras de otro proxy (Cloudflare, un balanceador), declararlo en
	# `trusted_proxies` o `remote_ip` va a ver la IP del proxy.
	#
	# @panel {
	# 	path /admin* /api/*
	# 	not path /api/media/file/*
	# 	not remote_ip 203.0.113.10/32 198.51.100.0/24
	# }
	# respond @panel 404

	reverse_proxy web:3000
}

# Con registro DNS para www, descomentar para mandarlo al dominio principal.
# www.{$DOMINIO} {
# 	redir https://{$DOMINIO}{uri} permanent
# }
