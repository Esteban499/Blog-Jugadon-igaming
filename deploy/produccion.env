# Configuracion de produccion que NO es secreta.
#
# Se versiona a proposito: son URLs y nombres publicos, y conviene que un cambio
# aca pase por revision como cualquier otro. Los secretos NO van aca: viven en
# el gestor de secretos (ver README, "Secretos").
#
# `desplegar.sh` se niega a correr mientras quede algun CAMBIAR.

# ---- Sitio ----
# El dominio con el que se sirve el sitio, tal cual se configuro en aaPanel.
NEXT_PUBLIC_SERVER_URL=https://CAMBIAR.com.ar

# ---- Archivos ----
# Las imagenes que se suben desde el panel viven en el disco de la VM, en el
# volumen `media-data` de docker-compose.prod.yml, y las sirve la app por
# /api/media/file/. No hay bucket ni credenciales: la ruta adentro del
# contenedor la fija MEDIA_DIR en el Dockerfile.
#
# La contracara es que ese volumen es el unico lugar donde estan: tiene que
# entrar al respaldo, cifrado y fuera de la VM, igual que el pg_dump.

# ---- Mapa ----
# Relativa: el .pmtiles lo sirve el Nginx de aaPanel desde el disco, por el
# mismo dominio que el sitio (ver `location ^~ /mapa/` en nginx-aapanel.conf).
# Al ser el mismo origen no hace falta CORS.
NEXT_PUBLIC_MAPA_TILES_URL=/mapa/jurisdicciones.pmtiles
NEXT_PUBLIC_MAPA_GLIFOS_URL=https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf

# ---- Shorts de YouTube ----
YOUTUBE_CANAL_ID=UCTM5tJIZsBNafsqqqDAYdXw

# ---- Tareas ----
# Una sola instancia: el corredor del bot va prendido.
EJECUTAR_TAREAS=true

# ---- Puertos en el loopback de la VM ----
# Nginx de aaPanel -> app, y build/respaldos -> base. Ninguno se abre afuera.
# Cambiarlos solo si aaPanel ya usa alguno (por ejemplo, un PostgreSQL propio
# en el 5432). PUERTO_WEB tiene que coincidir con `proxy_pass` en
# nginx-aapanel.conf.
PUERTO_WEB=3000
PUERTO_POSTGRES=5432
