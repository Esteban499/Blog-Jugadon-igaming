# Configuracion de produccion que NO es secreta.
#
# Se versiona a proposito: son URLs y nombres publicos, y conviene que un cambio
# aca pase por revision como cualquier otro. Los secretos NO van aca: viven en
# el gestor de secretos (ver README, "Secretos").
#
# `desplegar.sh` se niega a correr mientras quede algun CAMBIAR.

# ---- Sitio ----
DOMINIO=CAMBIAR.com.ar
NEXT_PUBLIC_SERVER_URL=https://CAMBIAR.com.ar

# ---- Archivos: Cloudflare R2 ----
# El endpoint es el de la cuenta de Cloudflare; el bucket, el del proyecto.
# Las claves de acceso son secretas y van en el gestor, no aca.
S3_BUCKET=blog-media
S3_ENDPOINT=https://CAMBIAR.r2.cloudflarestorage.com
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_S3_PUBLIC_URL=https://CAMBIAR.r2.dev

# ---- Mapa ----
# Absoluta, contra el dominio publico de R2. El bucket necesita el CORS que
# imprime scripts/generar-mapa.sh, con este dominio en AllowedOrigins.
NEXT_PUBLIC_MAPA_TILES_URL=https://CAMBIAR.r2.dev/mapa/jurisdicciones.pmtiles
NEXT_PUBLIC_MAPA_GLIFOS_URL=https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf

# ---- Shorts de YouTube ----
YOUTUBE_CANAL_ID=UCTM5tJIZsBNafsqqqDAYdXw

# ---- Tareas ----
# Una sola instancia: el corredor del bot va prendido.
EJECUTAR_TAREAS=true
