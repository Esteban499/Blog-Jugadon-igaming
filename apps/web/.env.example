# ---- Base de datos ----
# Puerto 5433: el 5432 suele estar tomado por un PostgreSQL instalado en la maquina.
DATABASE_URI=postgres://blog:blog@localhost:5433/payload_db

# ---- Payload ----
# En produccion: generar uno largo y aleatorio, y guardarlo como secret del cluster.
PAYLOAD_SECRET=cambiar-este-valor
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- Archivos ----
# No hay servicio de almacenamiento: Payload escribe los archivos que se suben
# desde el panel en el disco, y el mismo Next los sirve por /api/media/file/.
#
# La carpeta la fija `staticDir` en la coleccion Media: `apps/web/media/` en
# desarrollo, ignorada por git. En produccion, `MEDIA_DIR=/app/media`, que en el
# contenedor es un volumen de Docker (ver deploy/docker-compose.prod.yml).
#
# Es el unico lugar donde viven esos archivos: no hay bucket ni CDN que los
# replique, asi que el respaldo de la VM tiene que incluir ese volumen.

# ---- Mapa (MapLibre + Protomaps) ----
# El basemap entero es UN archivo .pmtiles servido desde el mismo dominio que
# el sitio. MapLibre lo lee por rangos HTTP: baja solo los pedazos que estan en
# pantalla, no el archivo completo.
#
# Sin clave, sin cuota y sin facturacion: el costo es el disco.
#
# Como generar el archivo, en README.
#
# Va RELATIVA, y por eso no hace falta CORS: sale por el mismo origen que el
# sitio. En desarrollo el archivo se copia a `apps/web/public/mapa/` y lo sirve
# Next; en produccion, a la carpeta del sitio en la VM, y lo sirve el Nginx de
# aaPanel (`location ^~ /mapa/`), que responde los 206 sin pasar por Node.
NEXT_PUBLIC_MAPA_TILES_URL=/mapa/jurisdicciones.pmtiles

# Las tipografias de los rotulos del mapa. Es el unico pedido a un tercero que
# queda; para cortarlo del todo, copiar el directorio de fuentes de
# protomaps/basemaps-assets junto al .pmtiles y apuntar esta variable ahi.
NEXT_PUBLIC_MAPA_GLIFOS_URL=https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf

# ---- Shorts de YouTube ----
# El id del canal, en formato UC... (24 caracteres). NO sirve el arroba: el feed
# de YouTube solo entiende el id.
#
# Como sacarlo: abrir el canal, ver el codigo fuente de la pagina y buscar
# "externalId"; o entrar a youtube.com/account_advanced con la cuenta del canal.
#
# Sin clave de API y sin cuota: la portada lee el feed publico del canal, que es
# XML plano y se cachea seis horas. Ver src/utilidades/shorts.ts.
#
# Sin esta variable la seccion de shorts sencillamente no se dibuja; el resto
# del sitio anda igual.
YOUTUBE_CANAL_ID=
