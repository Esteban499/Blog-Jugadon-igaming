# ---- Base de datos ----
# Puerto 5433: el 5432 suele estar tomado por un PostgreSQL instalado en la maquina.
DATABASE_URI=postgres://blog:blog@localhost:5433/payload_db

# ---- Payload ----
# En produccion: generar uno largo y aleatorio, y guardarlo como secret del cluster.
PAYLOAD_SECRET=cambiar-este-valor
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- Almacenamiento S3 ----
# Local: MinIO. Produccion: Cloudflare R2 (solo cambian estos valores).
S3_BUCKET=blog-media
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO necesita path-style; R2 tambien lo acepta.
S3_FORCE_PATH_STYLE=true
# URL publica desde donde se sirven los archivos.
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/blog-media

# ---- Mapa (MapLibre + Protomaps) ----
# El basemap entero es UN archivo .pmtiles servido desde el mismo bucket que el
# resto del media. MapLibre lo lee por rangos HTTP: baja solo los pedazos que
# estan en pantalla, no el archivo completo.
#
# Sin clave, sin cuota y sin facturacion: el costo es el storage. En R2 ademas
# no se paga egress. El bucket tiene que permitir CORS y peticiones Range.
#
# Como generar el archivo, en README.
NEXT_PUBLIC_MAPA_TILES_URL=http://localhost:9000/blog-media/mapa/jurisdicciones.pmtiles

# Las tipografias de los rotulos del mapa. Es el unico pedido a un tercero que
# queda; para cortarlo del todo, copiar el directorio de fuentes de
# protomaps/basemaps-assets al bucket y apuntar esta variable ahi.
NEXT_PUBLIC_MAPA_GLIFOS_URL=https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf
