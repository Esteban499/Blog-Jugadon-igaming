DATABASE_URI=postgres://blog:blog@localhost:5433/payload_db

PAYLOAD_SECRET=dev-secret-solo-para-local-no-usar-en-produccion
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- Mapa (MapLibre + Protomaps) ----
# Basemap propio: un solo .pmtiles leido por rangos HTTP. Sin clave ni cuota.
# El archivo va en public/mapa/, asi que lo sirve el mismo Next y el mapa anda
# tambien desde el celular. En produccion, el Nginx de aaPanel. Ver .env.example.
NEXT_PUBLIC_MAPA_TILES_URL=/mapa/jurisdicciones.pmtiles
NEXT_PUBLIC_MAPA_GLIFOS_URL=https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf

# ---- Shorts de YouTube ----
# El id del canal, en formato UC... (24 caracteres). NO sirve el arroba: el feed
# de YouTube solo entiende el id.
#
# Como sacarlo: abrir el canal, ver el codigo fuente de la pagina y buscar
# "externalId"; o entrar a youtube.com/account_advanced con la cuenta del canal.
#
# Sin clave de API y sin cuota: la portada lee el feed publico del canal, que es
# XML plano y se cachea seis horas. Ver src/utilidades/shorts.ts.
#
# Sin esta variable la seccion de shorts sencillamente no se dibuja; el resto
# del sitio anda igual.
YOUTUBE_CANAL_ID=UCTM5tJIZsBNafsqqqDAYdXw
