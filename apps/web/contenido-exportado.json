    "contenido": [
      {
        "id": "6a78db47f789164e484ddbb4",
        "blockName": null,
        "blockType": "contenido",
        "texto": {
          "root": {
            "type": "root",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "type": "paragraph",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "La cuota decimal expresa cuanto se cobra por cada unidad apostada, incluido el importe original. Una cuota de 2.50 devuelve 2,50 por cada 1 apostado: 1,50 de ganancia mas el 1 que pusiste.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr",
                "textFormat": 0
              }
            ],
            "direction": "ltr"
          }
        }
      },
      {
        "id": "6a78db47f789164e484ddbb5",
        "tipo": "juego-responsable",
        "blockName": null,
        "blockType": "aviso",
        "texto": {
          "root": {
            "type": "root",
            "format": "",
            "indent": 0,
            "version": 1,
            "children": [
              {
                "type": "paragraph",
                "format": "",
                "indent": 0,
                "version": 1,
                "children": [
                  {
                    "mode": "normal",
                    "text": "Este contenido es informativo. Apostar implica riesgo de perdida: definí un limite antes de empezar y no lo muevas.",
                    "type": "text",
                    "style": "",
                    "detail": 0,
                    "format": 0,
                    "version": 1
                  }
                ],
                "direction": "ltr",
                "textFormat": 0
              }
            ],
            "direction": "ltr"
          }
        }
      },
