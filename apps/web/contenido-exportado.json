        "altura": 400,
        "codigo": "<html lang=\"es\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Bienvenida</title>\r\n  \r\n  <!-- Fuente Google Fonts: Montserrat (700) -->\r\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n  <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&display=swap\" rel=\"stylesheet\">\r\n\r\n  <style>\r\n    * {\r\n      box-sizing: border-box;\r\n      margin: 0;\r\n      padding: 0;\r\n    }\r\n\r\n    body {\r\n      background-color: #0f172a; /* Fondo oscuro elegante */\r\n      font-family: 'Montserrat', sans-serif;\r\n      min-height: 100vh;\r\n      display: flex;\r\n      justify-content: center;\r\n      align-items: center;\r\n    }\r\n\r\n    .title-container {\r\n      text-align: center;\r\n      padding: 20px;\r\n    }\r\n\r\n    .welcome-title {\r\n      font-size: 3rem;\r\n      font-weight: 800;\r\n      /* Texto en degradado */\r\n      background: linear-gradient(135deg, #38bdf8 0%, #818cf8 50%, #c084fc 100%);\r\n      -webkit-background-clip: text;\r\n      -webkit-text-fill-color: transparent;\r\n      /* Sombra de texto suave */\r\n      filter: drop-shadow(0px 4px 12px rgba(56, 189, 248, 0.3));\r\n      letter-spacing: -0.5px;\r\n      transition: transform 0.3s ease;\r\n    }\r\n\r\n    .welcome-title:hover {\r\n      transform: scale(1.03);\r\n    }\r\n\r\n    /* Adaptación para pantallas chicas */\r\n    @media (max-width: 600px) {\r\n      .welcome-title {\r\n        font-size: 2rem;\r\n      }\r\n    }\r\n  </style>\r\n</head>\r\n<body>\r\n\r\n  <div class=\"title-container\">\r\n    <h1 class=\"welcome-title\">Bienvenido a Jugadon!</h1>\r\n  </div>\r\n\r\n</body>\r\n</html>",
